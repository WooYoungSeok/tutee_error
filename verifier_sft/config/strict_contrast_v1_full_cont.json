{
  "experiment": "strict_contrast_v1_full_cont",
  "status": "researcher request 2026-09-29: same recipe as strict_contrast_v1_halfA_cont applied to the verifier trained on the whole v2 train",
  "continued_training": {
    "init_checkpoint": "WooYoungSeok/qwen2.5-math-7b-descriptive-verifier-v2",
    "init_note": "v2 verifier trained on the whole v2 train (both halves), best epoch 3 (checkpoint-513); trained further on the audited same-question rows of every non-test group (halves A and B)",
    "baseline_for_comparison": "the init checkpoint itself, evaluated on the same test, contrast_test and test_augmented files"
  },
  "sft_data": {
    "audits": "outputs/strict_contrast_v1/audit/audits.jsonl",
    "half": "all",
    "positives": "audited_only",
    "positives_options": "audited_only | existing_all (see build_contrast_sft.py)",
    "existing_train": "data/descriptive_v2/train.jsonl",
    "v2_test": "data/descriptive_v2/test.jsonl",
    "positives_note": "same as strict_contrast_v1_halfA_cont: only audited rows of question groups with two or more solutions, here from both halves; no cross-question negatives"
  },
  "seed": 42,
  "prompt": {
    "system": "prompts/system.txt",
    "user": "prompts/user.txt",
    "ablations": {
      "no_solution": "prompts/user_ablation_no_solution.txt",
      "description_only": "prompts/user_ablation_description_only.txt"
    }
  },
  "model": {
    "name": "WooYoungSeok/qwen2.5-math-7b-descriptive-verifier-v2",
    "max_seq_length": 4096
  },
  "output": {
    "data_dir": "data/strict_contrast_v1_full_cont",
    "report": "reports/strict_contrast_v1_full_cont/data_report.md",
    "report_dir": "reports/strict_contrast_v1_full_cont"
  },
  "training": {
    "checkpoint_dir": "checkpoints",
    "num_train_epochs": 3,
    "learning_rate": 5e-06,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "per_device_train_batch_size": 8,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 4,
    "bf16": true,
    "gradient_checkpointing": true,
    "eval_and_save": "epoch",
    "metric_for_best_model": "eval_loss",
    "save_total_limit": null,
    "logging_steps": 10,
    "padding_side": "left",
    "report_to": "wandb",
    "dataloader_num_workers": 4,
    "use_validation": false,
    "save_only_model": true
  },
  "evaluation": {
    "split": "test",
    "max_new_tokens": 10,
    "batch_size": 8,
    "min_support_for_label_pairs": 10,
    "bootstrap_samples": 1000,
    "output_dir": "outputs/strict_contrast_v1_full_cont"
  }
}
